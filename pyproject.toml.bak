[project]
name = "unsloth-agent"
version = "0.1.0"
description = "GRPO post-training with Unsloth + TRL + vLLM, configured with sws"
readme = "README.md"
authors = [
    { name = "carlesoctav", email = "carlesoctavianus@tuta.io" }
]
requires-python = ">=3.12,<3.14"
dependencies = [
    "datasets",
    "h5py",
    "pandas",
    "pyarrow",
    "requests",
    "sws-config>=0.6.3",
    "trackio",
    # Pinned as a set: unsloth 2026.9.12 needs trl<=0.24 + transformers<=5.5,
    # and TRL 0.24 breaks against transformers>5.5 (it reads the removed
    # bool return of transformers' _is_package_available). vllm 0.24+ needs
    # transformers>5.5, so 0.23.0 is the newest compatible vllm; it is
    # linux-marked (no macOS/Windows wheels) and the lock forks there.
    # Revisit when unsloth supports a newer trl. Do not widen these to
    # ranges: the resolver unifies downward to fossil vllm instead of
    # forking (0.11.0, even 0.2.5).
    "transformers",
    "trl",
    "unsloth",
    "vllm",
]
[project.scripts]
unsloth-agent = "unsloth_agent:main"

[build-system]
requires = ["uv_build>=0.12.12,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest",
]
